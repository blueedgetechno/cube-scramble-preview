{
  "manifest_version": 3,
  "name": "Scramble Preview",
  "version": "1.0.0",
  "description": "Detects a 3x3 scramble on the page and previews the scrambled cube as an unfolded net.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Scramble Preview",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
